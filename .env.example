# Streaming Assistant Gateway Configuration
# Copy this file to .env and configure your values.
# Do NOT commit .env with real credentials to source control.

UPSTREAM_PROVIDER=synthetic  # synthetic | gemini | groq
UPSTREAM_API_KEY=
UPSTREAM_MODEL=gemini-2.0-flash
SYNTHETIC_TOKENS_PER_SECOND=25.0

REDIS_URL=redis://redis:6379/0
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
GRPC_BIND_HOST=0.0.0.0
GRPC_BIND_PORT=50051

RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30
DRAIN_TIMEOUT_SECONDS=5.0
LEASE_TTL_MS=5000
SUBSCRIBER_TTL_SECONDS=30.0
GENERATION_TTL_SECONDS=3600
